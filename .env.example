# Copy this file to .env.local and enter the values from your Supabase project.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional: Base site URL for production deployments (e.g. on Render)
# If omitted, PLAY ARENA automatically uses window.location.origin in the browser.
# VITE_SITE_URL=https://your-app-name.onrender.com

# Never put a Supabase service-role/secret key in a Vite variable or browser code.
